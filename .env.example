# ==============================================================================
# UES 3+ BR FAMILY RENTAL AGENT - ENVIRONMENT CONFIGURATION (100% FREE STACK)
# ==============================================================================

# 1. Google Gemini API (Free Tier via Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 2. Telegram Bot API (100% Free via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your numeric Telegram chat/user ID (message @userinfobot to get it).
# Enforces strict single-user access control so only you receive alerts & train the agent.
TELEGRAM_ALLOWED_CHAT_ID=123456789

# 3. Storage Backend ("local" or "supabase")
# - Use "local" for zero-config persistent JSON storage in ./data/agent_memory.json
# - Use "supabase" for free-tier Supabase PostgreSQL persistence (recommended for Render)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/agent_memory.json

# Supabase Free Tier Settings (only required if STORAGE_BACKEND=supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key_here

# 4. Agent Search & Conviction Policy
MIN_CONVICTION_SCORE=85
MIN_BEDROOMS=3
MAX_MONTHLY_RENT=18000
SCAN_INTERVAL_MINUTES=30
MAX_IMAGES_PER_LISTING=4

# Target UES Neighborhoods (comma-separated)
TARGET_NEIGHBORHOODS=Upper East Side,Carnegie Hill,Yorkville,Lenox Hill

# Optional: Enable Demo/Seed listings if live scraping is blocked or for testing
ENABLE_DEMO_MODE=false
